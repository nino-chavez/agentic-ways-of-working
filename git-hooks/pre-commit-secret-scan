#!/usr/bin/env bash
# Block commits that stage a literal provider credential.
#
# Why this exists: a secrets convention with no mechanical check is a habit,
# and habits lose. A tracked `.opvault` template once held a live API key in
# plaintext three lines above two correct `op://` references in the same file,
# committed and pushed. The naming convention had been carrying the entire
# burden of enforcement. See principles/working-style.md § Secret handling.
#
# Scope and limits, stated plainly:
#   - It scans STAGED content only. Passing says nothing about history. A key
#     already pushed needs rotation, not a scrub.
#   - It matches known provider PREFIXES. That list is the part that rots:
#     adding a service means adding its prefix below. It will not catch a
#     bare hex token with no distinguishing prefix.
#   - It is a floor, not a guarantee.
#
# Install: git-hooks/install.sh, or symlink into .git/hooks/pre-commit.
# Bypass (deliberate fixtures, docs about the format): git commit --no-verify

set -uo pipefail

# One prefix per line. Keep alphabetical-ish; add new providers here.
PATTERNS=(
  'AKIA[0-9A-Z]{16}'                  # AWS access key id
  'ctx7sk-[0-9a-f-]{8,}'              # Context7
  'dop_v1_[0-9a-f]{64}'               # DigitalOcean
  'ghp_[A-Za-z0-9]{36}'               # GitHub personal access token
  'gho_[A-Za-z0-9]{36}'               # GitHub OAuth token
  'github_pat_[A-Za-z0-9_]{22,}'      # GitHub fine-grained PAT
  'glpat-[A-Za-z0-9_-]{20}'           # GitLab
  'pit-[0-9a-f]{8}-[0-9a-f]{4}'       # GoHighLevel private integration token
  'sk-ant-[A-Za-z0-9_-]{20,}'         # Anthropic
  'sk-proj-[A-Za-z0-9_-]{20,}'        # OpenAI project key
  'sk_live_[A-Za-z0-9]{24,}'          # Stripe live
  'xox[baprs]-[A-Za-z0-9-]{10,}'      # Slack
  '-----BEGIN [A-Z ]*PRIVATE KEY-----'
)

joined=$(IFS='|'; echo "${PATTERNS[*]}")

staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

# Skip this hook's own source — it necessarily contains the patterns.
self="git-hooks/pre-commit-secret-scan"

hits=""
while IFS= read -r file; do
  [ "$file" = "$self" ] && continue
  # Added lines only, minus any carrying the allowlist pragma. Redaction tests
  # and format documentation legitimately contain key-shaped strings; without
  # an escape they train the habit of reflexively passing --no-verify.
  added=$(git diff --cached -U0 -- "$file" | grep '^+' | grep -v '^+++' \
    | grep -v 'pragma: allowlist secret')
  [ -z "$added" ] && continue
  match=$(printf '%s\n' "$added" | grep -oIE "($joined)" | head -3 \
    | sed -E 's/^(.{12}).*/\1…/')
  [ -z "$match" ] && continue
  hits+="  $file"$'\n'
  while IFS= read -r m; do hits+="    → $m"$'\n'; done <<< "$match"
done <<< "$staged"

if [ -n "$hits" ]; then
  cat >&2 <<EOF

  BLOCKED: staged changes contain what looks like a live credential.

$hits
  Secrets belong in the secrets manager, referenced from a template:
    Authorization = "Bearer {{ op://Developer Secrets/<Item>/credential }}"

  List existing items before inventing a name:
    op item list --vault "Developer Secrets"

  If this key was ever committed or pushed, ROTATE it — removing the line
  does not remove it from history.

  Deliberate fixture or documentation about the format? Mark the line, so the
  exemption is reviewable and the gate keeps working on everything else:
    const FAKE = "sk-ant-..."  // pragma: allowlist secret

  Last resort, exempts the whole commit:
    git commit --no-verify

EOF
  exit 1
fi

exit 0
